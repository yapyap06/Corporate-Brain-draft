# MEETINGS Module — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ── Required for real AI processing ──
GEMINI_API_KEY=your_gemini_api_key_here
# Get from: https://aistudio.google.com/app/apikey

HF_TOKEN=your_huggingface_token_here
# Get from: https://huggingface.co/settings/tokens
# Must accept the PyAnnote model license at:
# https://huggingface.co/pyannote/speaker-diarization-3.1

# ── Demo mode (set true to run without API keys) ──
DEMO_MODE=false

# ── Whisper model size ──
# Options: tiny | base | small | medium | large
# tiny   = fastest (good for testing)
# small  = balanced (recommended)
# medium = best accuracy, slower
WHISPER_MODEL=small

# ── File storage paths ──
UPLOAD_DIR=./uploads
RESULTS_DIR=./results

# ── Processing settings ──
MAX_FILE_SIZE_MB=500
FRAME_INTERVAL_S=10     # How often to sample video frames for name detection
USE_GPU=true            # Set false to force CPU (slower but always works)

# ── CORS ──
FRONTEND_URL=http://localhost:8765
