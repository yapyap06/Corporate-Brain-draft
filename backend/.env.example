# Corporate Brain — Environment Variables
# Copy this to .env and fill in your keys

# ── AI Keys ──
GEMINI_API_KEY=your_gemini_api_key_here
# Get from: https://aistudio.google.com/app/apikey

# ── Neo4j (optional — app works without it in demo mode) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=corporatebrain

# ── App Settings ──
APP_ENV=development          # development | production
DEMO_MODE=true               # true = use mock data when AI keys missing
UPLOAD_DIR=./uploads         # where Coco saves audio files

# ── CORS (frontend origin) ──
FRONTEND_URL=http://localhost:8765

# ── Whisper Model ──
# tiny   = fastest, least accurate (good for demo)
# base   = balanced
# small  = better accuracy
# medium = best accuracy, slower
WHISPER_MODEL=base
